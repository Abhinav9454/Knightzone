# Template environment file.
# Copy this file to `.env` and replace placeholder values before running the app.
# `.env` is the real runtime file. `.env.example` is only a safe sample.

# Core security
JWT_SECRET=local-knights-battle-zone-jwt-secret-2026-change-before-deployment
TRACKER_TOKEN_SECRET=local-knights-battle-zone-tracker-secret-2026-change-before-deployment
JUDGE_INTERNAL_TOKEN=local-knights-battle-zone-judge-token-2026-change-before-deployment
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Optional admin bootstrap (disabled by default)
BOOTSTRAP_ADMIN_ENABLED=false
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# Production profile (set in deployment)
SPRING_PROFILES_ACTIVE=prod
SPRING_JPA_HIBERNATE_DDL_AUTO=update

# Database / cache / broker (examples)
DB_URL=jdbc:mysql://mysql:3306/Unified_database?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
DB_USER=unified_code_db
DB_PASSWORD=abhinav!@nag9454
SPRING_DATASOURCE_PASSWORD=abhinav!@nag9454
DEV_DB_PASSWORD=abhinav!@nag9454
DB_READ_REPLICA_ENABLED=false
DB_READ_REPLICA_URL=jdbc:mysql://mysql-read:3306/contestdb?useSSL=true&requireSSL=true&serverTimezone=UTC
DB_READ_REPLICA_USER=contestuser_ro
DB_READ_REPLICA_PASSWORD=replace-with-strong-read-password
APP_DB_ROUTING_ENABLED=false
APP_DB_ROUTING_READ_ONLY_TX_ONLY=true
MYSQL_DATABASE=Unified_database
MYSQL_USER=unified_code_db
MYSQL_PASSWORD=abhinav!@nag9454
MYSQL_ROOT_PASSWORD=abhinav!@nag9454
# Optional: override Docker volume name for MySQL data persistence
MYSQL_VOLUME_NAME=college-contest-platform_mysql_data
DOCKER_GID=0
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=replace-with-strong-password

# Judge and rate-limit tuning (optional, recommended for high load)
JUDGE_QUEUE_LISTENER_CONCURRENCY=4-12
JUDGE_QUEUE_SUBMIT_LISTENER_CONCURRENCY=4-12
JUDGE_QUEUE_RUN_LISTENER_CONCURRENCY=3-8
JUDGE_QUEUE_HIGH_LISTENER_CONCURRENCY=4-16
JUDGE_QUEUE_PREFETCH=20
JUDGE_QUEUE_RETRY_DELAY_MS=4500
JUDGE_QUEUE_MAX_RETRIES=4
JUDGE_QUEUE_RETRY_BATCH_SIZE=100
JUDGE_QUEUE_HIGH_PRIORITY_WINDOW_SECONDS=240
JUDGE_QUEUE_POLL_LEGACY_STATUS_ENABLED=false
JUDGE_ASYNC_NON_BLOCKING_ENABLED=true
JUDGE_EVENTS_RESULT_CONSUMER_ENABLED=true
JUDGE_RESULT_LISTENER_CONCURRENCY=4-16
JUDGE_RUN_PREFER_LEGACY=true
JUDGE_RUN_MAX_ATTEMPTS=1
JUDGE_RUN_ASYNC_FALLBACK_ENABLED=false
JUDGE_RUN_POLL_TIMEOUT_MS=1200
JUDGE_EXECUTION_WAIT_THREAD_POOL_SIZE=48
JUDGE_EXECUTION_BATCH_MODE_ENABLED=true
JUDGE_EXECUTION_BATCH_FOR_SUBMIT_ENABLED=true
JUDGE_EXECUTION_BATCH_MIN_TESTCASES=2
JUDGE_EXECUTION_WORKER_POOL_ENABLED=true
JUDGE_EXECUTION_WORKER_POOL_INITIAL_SIZE=1
JUDGE_EXECUTION_WORKER_POOL_MAX_PER_LANGUAGE=0
JUDGE_EXECUTION_MAX_ACTIVE_CONTAINERS=24
JUDGE_EXECUTION_QUEUE_WAIT_TIMEOUT_MS=2500
JUDGE_EXECUTION_STOP_ON_FIRST_FAILURE=true
JUDGE_EXECUTION_LANGUAGE_LIMIT_JAVA=8
JUDGE_EXECUTION_LANGUAGE_LIMIT_PYTHON=10
JUDGE_EXECUTION_LANGUAGE_LIMIT_CPP=12
JUDGE_EXECUTION_LANGUAGE_LIMIT_NODE=6
DB_HIKARI_MAX_POOL_SIZE=60
DB_HIKARI_MIN_IDLE=20
DB_HIKARI_CONNECTION_TIMEOUT_MS=2000
DB_READ_HIKARI_MAX_POOL_SIZE=45
DB_READ_HIKARI_MIN_IDLE=10
WS_BROKER_RELAY_ENABLED=false
WS_BROKER_RELAY_HOST=rabbitmq
WS_BROKER_RELAY_PORT=61613
WS_BROKER_CLIENT_LOGIN=guest
WS_BROKER_CLIENT_PASSCODE=guest
WS_BROKER_SYSTEM_LOGIN=guest
WS_BROKER_SYSTEM_PASSCODE=guest
WS_BROKER_VHOST=/
WS_BROKER_DESTINATION_PREFIXES=/topic,/queue
RATE_LIMIT_STORAGE=redis
